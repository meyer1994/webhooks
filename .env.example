# DATABASE_URL is only needed for drizzle-kit commands that require a direct
# DB connection (db:push, db:pull, db:studio). It is NOT used by the app —
# the app accesses the database through the Cloudflare D1 binding.
#
# After running `pnpm db:migrate`, wrangler creates a local SQLite file at:
#   .wrangler/state/v3/d1/miniflare-D1DatabaseObject/<hash>.sqlite
#
# Point DATABASE_URL at that file, or leave it as the default below if you
# prefer a separate file managed outside of wrangler state.
DATABASE_URL=file:.data/db.sqlite
