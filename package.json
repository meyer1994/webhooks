{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:systemd": "systemd-run --user --scope -p MemoryMax=4096M nuxt dev",
    "test": "vitest --run --reporter verbose",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "clean": "rm -rf .output .wrangler .nuxt",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "reset": "pnpm clean && rm -rf node_modules  && pnpm install && pnpm run lint && pnpm run typecheck && pnpm run build",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply webhooks",
    "cf:deploy": "pnpm run build && wrangler --cwd .output deploy",
    "cf:types": "wrangler types shared/wrangler.d.ts"
  },
  "dependencies": {
    "@nuxt/eslint": "1.15.2",
    "@nuxt/ui": "^4.7.1",
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@vueuse/components": "^14.3.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.0.0",
    "echarts-simple-transform": "^1.0.0",
    "nuxt": "^4.4.5",
    "nuxt-echarts": "1.0.1",
    "trpc-nuxt": "^2.0.2",
    "uuidv7": "^1.2.1",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.108",
    "@nuxt/test-utils": "^4.0.3",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.8.0",
    "@vue/test-utils": "^2.4.10",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "happy-dom": "^20.9.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "playwright": "^1.60.0",
    "playwright-core": "^1.60.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.2.9",
    "wrangler": "^4.92.0"
  }
}